// Prisma Schema for AFAQ Innovation Portal
// Database: MySQL
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==================== USER & AUTHENTICATION ====================

model User {
  id          String   @id @default(cuid())
  militaryId  String   @unique
  password    String   // hashed with bcrypt
  email       String   @unique
  role        UserRole @default(STUDENT)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  profile       StudentProfile?
  projects      ProjectMember[]
  labBookings   LabBooking[]
  eventRegistrations EventRegistration[]
  createdProjects Project[] @relation("ProjectCreator")
  createdEvents   Event[]   @relation("EventCreator")

  @@map("users")
}

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

// ==================== ACADEMIC STRUCTURE ====================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  programmes  Programme[]
  students    StudentProfile[]
  labs        Lab[]

  @@map("departments")
}

model Programme {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  departmentId String
  level        String?  // e.g., "Diploma", "Bachelor", "Master"
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  department   Department @relation(fields: [departmentId], references: [id])
  students     StudentProfile[]

  @@map("programmes")
}

// ==================== STUDENT PROFILE ====================

model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  fullName     String
  phone        String?
  
  departmentId String
  programmeId  String
  yearLevel    String?  // e.g., "Level 3", "Year 2"
  
  bio          String?  @db.Text
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department  @relation(fields: [departmentId], references: [id])
  programme    Programme   @relation(fields: [programmeId], references: [id])
  
  experiences  Experience[]
  trainings    Training[]
  competitions Competition[]
  skills       Skill[]

  @@map("student_profiles")
}

model Experience {
  id          String   @id @default(cuid())
  profileId   String
  
  title       String   // Role/Title
  place       String   // Company/Organization
  year        String   // Year or period
  type        String?  // e.g., "Internship", "Volunteer"
  description String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  profile     StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

model Training {
  id          String   @id @default(cuid())
  profileId   String
  
  title       String
  provider    String   // e.g., "MTC", "Vendor"
  year        String
  hours       String?  // e.g., "10 hours"
  description String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  profile     StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("trainings")
}

model Competition {
  id          String   @id @default(cuid())
  profileId   String
  
  eventName   String
  role        String   // e.g., "Participant", "Team Leader"
  year        String
  result      String?  // e.g., "Top 5", "Completed"
  description String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  profile     StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("competitions")
}

model Skill {
  id          String   @id @default(cuid())
  profileId   String
  name        String   // e.g., "Python", "SIEM", "Drones"
  
  createdAt   DateTime @default(now())

  // Relations
  profile     StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("skills")
}

// ==================== PROJECTS ====================

model Project {
  id           String        @id @default(cuid())
  title        String
  description  String        @db.Text
  status       ProjectStatus
  category     String        // e.g., "Cybersecurity", "IoT", "AI", "Robotics"
  progress     Int           @default(0) // 0-100
  
  startDate    DateTime?
  endDate      DateTime?
  
  createdById  String
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  createdBy    User          @relation("ProjectCreator", fields: [createdById], references: [id])
  members      ProjectMember[]
  attachments  ProjectAttachment[]

  @@map("projects")
}

enum ProjectStatus {
  START
  DEVELOPMENT
  COMPLETED
}

model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  role        String   @default("Member") // e.g., "Leader", "Member", "Mentor"
  status      MemberStatus @default(PENDING)
  
  joinedAt    DateTime @default(now())

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
  INVITED
}

model ProjectAttachment {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  url         String
  type        String   // "IMAGE", "DOCUMENT"
  
  uploadedAt  DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@map("project_attachments")
}

// ==================== LABS & EQUIPMENT ====================

model LabCategory {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "club", "specialised", "handsOn", "tools"
  label       String   // e.g., "Scientific Club Labs"
  description String   @db.Text
  icon        String?  // Font Awesome class
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  labs        Lab[]

  @@map("lab_categories")
}

model Lab {
  id          String   @id @default(cuid())
  name        String
  shortDesc   String
  tag         String   // e.g., "Electronics", "Robotics"
  categoryId  String
  departmentId String?
  
  capacity    Int      @default(1)
  isBookable  Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  category    LabCategory @relation(fields: [categoryId], references: [id])
  department  Department? @relation(fields: [departmentId], references: [id])
  bookings    LabBooking[]

  @@map("labs")
}

model LabBooking {
  id          String   @id @default(cuid())
  labId       String
  userId      String
  
  bookingDate DateTime
  timeSlot    String   // e.g., "09:00-11:00"
  purpose     String?  @db.Text
  status      BookingStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lab_bookings")
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

// ==================== EVENTS ====================

model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  category    String   // e.g., "Workshop", "Competition", "Exhibition"
  
  startDate   DateTime
  endDate     DateTime?
  location    String?
  capacity    Int?
  
  createdById String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy   User     @relation("EventCreator", fields: [createdById], references: [id])
  registrations EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  status      RegistrationStatus @default(REGISTERED)
  
  registeredAt DateTime @default(now())

  // Relations
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_registrations")
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

// ==================== RESEARCH ====================

model Research {
  id          String   @id @default(cuid())
  title       String
  abstract    String   @db.Text
  authors     String   @db.Text // JSON array or comma-separated
  category    String   // e.g., "Published", "Ongoing", "Thesis"
  publicationDate DateTime?
  url         String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("research")
}
