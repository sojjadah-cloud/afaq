# Production environment variables (all optional).
# The app needs no external services: it uses a bundled SQLite database that is
# created from data/seed.sql on first start, and uploaded files are stored in it.

# Recommended: a random secret of at least 32 characters for signing session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="GENERATE_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS"

# Optional: path to the SQLite database file. Defaults to data/afaq.db.
# Point it at a persistent disk (e.g. /var/data/afaq.db on Render) to keep
# user-created data and uploads across redeploys.
# DATABASE_URL="/var/data/afaq.db"
