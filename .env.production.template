# Production Environment Variables Template
# DO NOT commit this file with actual values!
# Configure these in Vercel Dashboard: Settings > Environment Variables

# Database Configuration
# Choose ONE of the following options:

# OPTION 1: Railway MySQL (Recommended - Most Compatible)
# Sign up: https://railway.app (Free trial: $5 credit, no expiration)
# Format: mysql://username:password@host:port/database
DATABASE_URL="mysql://root:PASSWORD@containers-us-west-xxx.railway.app:PORT/railway"

# OPTION 2: Neon Postgres (Best Free Tier)
# Sign up: https://neon.tech (Free: 3GB storage, 0.5GB RAM, unlimited projects)
# Format: postgresql://username:password@host/database?sslmode=require
# NOTE: Requires converting MySQL schema to Postgres
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Session Secret (CRITICAL - Generate a new secure secret)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="GENERATE_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS"

# App URL (Update with your actual Vercel deployment URL)
NEXT_PUBLIC_APP_URL="https://afaq-innovation.vercel.app"

# =======================
# CLOUDINARY (File Uploads)
# =======================
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ============================================
# INSTRUCTIONS FOR DEPLOYMENT:
# ============================================
# 
# OPTION 1: Railway (MySQL - Easiest Migration)
# ------------------------------------------------
# 1. Visit https://railway.app and sign up
# 2. Create new project → Add MySQL database
# 3. Get connection string from Variables tab
# 4. Export local database: mysqldump -u root afaq_innovation > backup.sql
# 5. Import using Railway CLI or connect directly via MySQL client
# 6. Free trial: $5 credit (lasts months for small projects)
#
# OPTION 2: Neon (Postgres - Best Free Tier)
# ------------------------------------------------
# 1. Visit https://neon.tech and create account
# 2. Create new project → Note connection string
# 3. Convert MySQL schema to Postgres (I can help with this)
# 4. Run migrations on Neon database
# 5. Free tier: 3GB storage, unlimited projects
#
# ALTERNATIVE: Supabase (Postgres)
# ------------------------------------------------
# Visit https://supabase.com - Free tier: 500MB database
# Similar to Neon but includes authentication & storage
#
# 2. Generate Secure Session Secret:
#    Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    Copy the output and use as SESSION_SECRET
#
# 3. Configure in Vercel:
#    - Go to your project in Vercel Dashboard
#    - Settings > Environment Variables
#    - Add each variable above with actual values
#    - Make sure to select "Production" environment
#
# 4. Redeploy:
#    - After adding env variables, trigger a new deployment
#    - Vercel will use the new configuration
